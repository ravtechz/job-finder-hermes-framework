# Port (implicit 3333)
PORT=3333
# Interfața de ascultare. Lasă 127.0.0.1 ca să nu fie expus în rețea.
HOST=127.0.0.1
# Basic Auth opțional: se activează doar dacă ambele sunt setate (se aplică și pe /api)
DASH_USER=
DASH_PASS=
# Cheia agenților Hermes (header X-Agent-Key). Generează: openssl rand -hex 24
AGENT_KEY=
# Fusul orar pentru "azi"
APP_TZ=Europe/Bucharest
# Calea fișierului SQLite
DB_PATH=./data/jobs.db
